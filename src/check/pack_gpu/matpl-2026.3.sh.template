#!/bin/bash

# Default to single-core compilation
JOB_COUNT=1
UNPACK_ONLY=false
COMPILE_FORTRAN=false
GPU_ARCH=${GPU_ARCH:-AMPERE86}
DPREC=${DPREC:-}
DPREC_ENABLED=false

# OpenMPI 兼容性标志（默认为 true，环境检查后更新）
OPENMPI_COMPATIBLE=true

# Display help information
show_help() {
  echo "Usage: $0 [OPTIONS]"
  echo ""
  echo "Options:"
  echo "  -j N     Set the number of CPU cores for compilation (default: 1)"
  echo "  -m nn    Compile MatPL Linear/NN support with build.sh"
  echo "  -a ARCH  Set Kokkos CUDA architecture for lammps-2026.3 (default: AMPERE86)"
  echo "           ARCH is the Kokkos CUDA architecture suffix, for example AMPERE80, AMPERE86, ADA89, or HOPPER90. For more information on the architecture, please refer to https://docs.lammps.org/Build_extras.html#kokkos."
  echo "  -d       Enable DPREC_NEPINFER and build lammps-2026.3 in build-64"
  echo "  -u       Unpack the archive only, skip compilation"
  echo "  --gpu-arch ARCH  Same as -a ARCH"
  echo "  --dprec          Same as -d"
  echo "  -h, --help  Display this help message"
  exit 0
}

# Environment check functions
check_ifort_mkl() {
    echo "=== Checking ifort compiler and MKL library ==="

    if command -v ifort &> /dev/null; then
        ifort_version=$(ifort --version | grep "ifort" | awk '{print $3}' | cut -d'.' -f1-2)
        major_version=$(echo $ifort_version | cut -d'.' -f1)
        minor_version=$(echo $ifort_version | cut -d'.' -f2)

        if [ "$major_version" -gt 19 ] || ([ "$major_version" -eq 19 ] && [ "$minor_version" -ge 1 ]); then
            echo "✓ ifort version: $ifort_version (>= 19.1)"
            return 0
        else
            echo "✗ ifort version: $ifort_version (< 19.1)"
            return 1
        fi
    else
        echo "✗ ifort compiler not found"
        return 1
    fi
}

check_mkl() {
    if [ -d "/opt/intel/mkl" ] || [ -d "$MKLROOT" ] || [ ! -z "$MKLROOT" ]; then
        echo "✓ MKL library is installed"
        return 0
    else
        echo "✗ MKL library is not installed"
        return 1
    fi
}

check_gcc_version() {
    echo "=== Checking GCC version ==="
    
    if command -v gcc &> /dev/null; then
        gcc_version=$(gcc -dumpversion | cut -d. -f1)
        if [ "$gcc_version" -ge 8 ]; then
            echo "✓ GCC version: $(gcc -dumpversion) (>= 8.0)"
            return 0
        else
            echo "✗ GCC version: $(gcc -dumpversion) (< 8.0)"
            return 1
        fi
    else
        echo "✗ GCC not found"
        return 1
    fi
}

check_openmpi() {
  echo "=== Checking OpenMPI ==="
  local ompi_found=false
  local ompi_version=""

  # 方法1: 检查 ompi_info 命令（OpenMPI 特有）
  if command -v ompi_info &> /dev/null; then
    ompi_found=true
    # 使用正则提取版本号，更可靠
    ompi_version=$(ompi_info --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
    echo "✓ OpenMPI found (via ompi_info), version: ${ompi_version:-unknown}"
  # 方法2: 检查 mpirun --version 输出是否包含 "Open MPI"
  elif command -v mpirun &> /dev/null; then
    mpirun_version_output=$(mpirun --version 2>&1)
    if echo "$mpirun_version_output" | grep -qi "Open MPI"; then
      ompi_found=true
      ompi_version=$(echo "$mpirun_version_output" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
      echo "✓ OpenMPI found (via mpirun), version: ${ompi_version:-unknown}"
    else
      # 有其他 MPI 实现（如 Intel MPI），但不是 OpenMPI
      echo "⚠ Other MPI implementation detected (not OpenMPI):"
      echo "  $(mpirun --version 2>&1 | head -1)"
    fi
  fi

  if [ "$ompi_found" = true ]; then
    # 提取主版本号并检查是否 >=4
    if [ -n "$ompi_version" ]; then
      major_version=$(echo "$ompi_version" | cut -d'.' -f1)
      if [ "$major_version" -ge 4 ]; then
        echo "✓ OpenMPI version meets requirement (>= 4.0)"
        return 0
      else
        echo "✗ OpenMPI version: $ompi_version (< 4.0)"
        return 1
      fi
    else
      # 无法获取版本，但 OpenMPI 存在，假设满足要求
      echo "⚠ OpenMPI detected but version could not be determined. Assuming compatibility."
      return 0
    fi
  else
    echo "✗ OpenMPI not found"
    return 1
  fi
}

check_cuda_version() {
    echo "=== Checking CUDA version ==="
    
    if command -v nvcc &> /dev/null; then
        cuda_version=$(nvcc --version | grep "release" | awk '{print $6}' | cut -d"," -f1 | cut -c2-)
        major_version=$(echo $cuda_version | cut -d'.' -f1)
        minor_version=$(echo $cuda_version | cut -d'.' -f2)

        if [ "$major_version" -gt 11 ] || ([ "$major_version" -eq 11 ] && [ "$minor_version" -ge 8 ]); then
            echo "✓ CUDA version: $cuda_version (>= 11.8)"
            return 0
        else
            echo "✗ CUDA version: $cuda_version (< 11.8)"
            return 1
        fi
    else
        echo "✗ nvcc command not found, CUDA might not be installed"
        return 1
    fi
}

check_nvcc() {
    echo "=== Checking nvcc availability ==="
    
    if command -v nvcc &> /dev/null; then
        echo "✓ nvcc command exists"
        return 0
    else
        echo "✗ nvcc command does not exist"
        return 1
    fi
}

perform_environment_check() {
  echo "========================================"
  echo " Environment Check Starting"
  echo "========================================"
  echo ""

  # 环境检查结果标志
  ENV_PASS=true
  FORTRAN_COMPATIBLE=true
  CUDA_COMPATIBLE=true
  OPENMPI_COMPATIBLE=true  # 默认为 true，根据检查结果更新

  # 检查 ifort 和 MKL（仅在 -m nn 时需要）
  if [ "$COMPILE_FORTRAN" = true ]; then
    check_ifort_mkl
    ifort_result=$?
    check_mkl
    mkl_result=$?
    if [ $ifort_result -eq 0 ] && [ $mkl_result -eq 0 ]; then
      FORTRAN_COMPATIBLE=true
    else
      FORTRAN_COMPATIBLE=false
    fi
    echo ""
  fi

  # 检查 GCC
  check_gcc_version
  gcc_result=$?
  if [ $gcc_result -ne 0 ]; then
    ENV_PASS=false
  fi
  echo ""

  # 检查 OpenMPI - 现在改为警告模式，不影响 ENV_PASS
  check_openmpi
  openmpi_result=$?
  if [ $openmpi_result -eq 0 ]; then
    OPENMPI_COMPATIBLE=true
  else
    OPENMPI_COMPATIBLE=false
    echo "⚠ Warning: OpenMPI not found or version < 4.0. This will skip compilation of lammps-2026.3."
  fi
  echo ""

  # 检查 CUDA 相关信息 - 现在是强制要求
  check_cuda_version
  cuda_result=$?
  if [ $cuda_result -ne 0 ]; then
    CUDA_COMPATIBLE=false
    ENV_PASS=false
  fi
  echo ""
  check_nvcc
  nvcc_result=$?
  if [ $nvcc_result -ne 0 ]; then
    CUDA_COMPATIBLE=false
    ENV_PASS=false
  fi
  echo ""

  echo "========================================"
  echo " Environment Summary"
  echo "========================================"

  if [ "$COMPILE_FORTRAN" = true ] && [ "$FORTRAN_COMPATIBLE" = false ]; then
    echo "✗ Error: You requested MatPL Linear/NN compilation (-m nn) but the environment check failed for ifort/MKL."
    echo " Please install ifort (>= 19.1) and MKL before proceeding."
    echo " Or run without -m nn option to skip Linear/NN compilation."
    ENV_PASS=false
  fi

  # 如果 CUDA 检查失败，直接报错退出（GPU版本强制要求CUDA）
  if [ "$CUDA_COMPATIBLE" = false ]; then
    echo "✗ Error: CUDA environment check failed."
    echo " Please install CUDA (>= 11.8) and nvcc before proceeding."
    ENV_PASS=false
  fi

  # 注意：OpenMPI 检查不通过已改为警告，不再设置 ENV_PASS=false

  # Summary output
  if [ "$ENV_PASS" = true ]; then
    echo "✓ Environment check completed. All requirements are satisfied."
  else
    echo "✗ Environment check failed. Please review the above errors."
  fi

  echo "========================================"

  # 如果环境检查失败（CUDA或GCC导致），退出脚本
  if [ "$ENV_PASS" = false ]; then
    echo "Environment check failed. Aborting installation."
    exit 1
  fi
}

# Parse command line arguments
while [ $# -gt 0 ]; do
  case "$1" in
    -j)
      if [ -z "$2" ]; then
        echo "Option -j requires an argument." >&2
        show_help
      fi
      JOB_COUNT=$2
      echo "Using $JOB_COUNT CPU cores for compilation"
      shift 2
      ;;
    -j*)
      JOB_COUNT=${1#-j}
      echo "Using $JOB_COUNT CPU cores for compilation"
      shift
      ;;
    -m)
      if [ "$2" = "nn" ]; then
        COMPILE_FORTRAN=true
        echo "Will compile MatPL Linear/NN support"
        shift 2
      else
        echo "Error: -m option only accepts 'nn' as argument"
        show_help
      fi
      ;;
    -mnn)
      COMPILE_FORTRAN=true
      echo "Will compile MatPL Linear/NN support"
      shift
      ;;
    -a|--gpu-arch)
      if [ -z "$2" ]; then
        echo "Option $1 requires an argument." >&2
        show_help
      fi
      GPU_ARCH=$2
      shift 2
      ;;
    --gpu-arch=*)
      GPU_ARCH=${1#--gpu-arch=}
      shift
      ;;
    -d|--dprec)
      DPREC=ON
      shift
      ;;
    -u)
      UNPACK_ONLY=true
      echo "Unpack-only mode enabled"
      shift
      ;;
    -h|--help)
      show_help
      ;;
    *)
      echo "Invalid option: $1" >&2
      show_help
      ;;
  esac
done

case "${DPREC,,}" in
  1|true|yes|on)
    DPREC_ENABLED=true
    ;;
  ""|0|false|no|off)
    DPREC_ENABLED=false
    ;;
  *)
    echo "Invalid DPREC value: $DPREC. Use ON/OFF, true/false, or 1/0." >&2
    show_help
    ;;
esac

GPU_ARCH=${GPU_ARCH^^}
if [[ ! "$GPU_ARCH" =~ ^[A-Z][A-Z0-9_]*[0-9]+$ ]]; then
  echo "Invalid GPU architecture: $GPU_ARCH. Use a Kokkos CUDA architecture suffix such as AMPERE86." >&2
  exit 1
fi
CMAKE_CUDA_ARCHITECTURES=${GPU_ARCH##*[!0-9]}

echo "Using Kokkos CUDA architecture: $GPU_ARCH"
echo "Using CMake CUDA architecture: $CMAKE_CUDA_ARCHITECTURES"
if [ "$DPREC_ENABLED" = true ]; then
  echo "DPREC_NEPINFER enabled; lammps-2026.3 will be built in build-64"
fi

build_lammps_offline_deps() {
    local deps_dir=$1
    local prebuilt_prefix=$deps_dir/install
    local prefix=$deps_dir/install-local
    local build_dir=$deps_dir/build
    local openblas_lib=$prefix/lib/libopenblas.so
    local gsl_lib=$prefix/lib/libgsl.so
    local gsl_cblas_lib=$prefix/lib/libgslcblas.so
    local voro_lib=$prefix/lib/libvoro++.a
    local voro_header=$prefix/include/voro++/voro++.hh
    local gfortran_lib

    if [ -f "$prebuilt_prefix/lib/libvoro++.a" ] && \
       [ -f "$prebuilt_prefix/include/voro++/voro++.hh" ] && \
       [ -x "$prebuilt_prefix/bin/offline-deps-smoke" ]; then
        echo "Checking bundled prebuilt OpenBLAS and GSL..."
        if LD_LIBRARY_PATH="$prebuilt_prefix/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" \
            "$prebuilt_prefix/bin/offline-deps-smoke"; then
            LAMMPS_DEPS_PREFIX=$prebuilt_prefix
            export LAMMPS_DEPS_PREFIX
            export LD_LIBRARY_PATH="$LAMMPS_DEPS_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
            echo "Using bundled prebuilt OpenBLAS and GSL: $LAMMPS_DEPS_PREFIX"
            return 0
        fi
        echo "Warning: bundled OpenBLAS/GSL cannot run on this machine; trying the bundled sources."
    else
        echo "Warning: bundled OpenBLAS/GSL/Voro++ files are incomplete; trying the bundled sources."
    fi

    mkdir -p "$prefix" "$build_dir"

    if [ ! -f "$openblas_lib" ]; then
        echo "Building OpenBLAS for offline LAMMPS dependencies..."
        if [ ! -f "$deps_dir/OpenBLAS-0.3.23.tar.gz" ]; then
            echo "Error: $deps_dir/OpenBLAS-0.3.23.tar.gz not found"
            return 1
        fi
        rm -rf "$build_dir/OpenBLAS-0.3.23"
        tar -xzf "$deps_dir/OpenBLAS-0.3.23.tar.gz" -C "$build_dir"
        cd "$build_dir/OpenBLAS-0.3.23" || return 1
        if command -v gfortran >/dev/null 2>&1; then
            gfortran_lib=$(dirname "$(gfortran -print-file-name=libgfortran.so)")
            if [ -f "$gfortran_lib/libgfortran.so" ]; then
                export LIBRARY_PATH="$gfortran_lib:$LIBRARY_PATH"
            fi
        fi
        make -j$JOB_COUNT USE_OPENMP=0 DYNAMIC_ARCH=1
        if [ $? -ne 0 ]; then
            echo "Error: OpenBLAS build failed"
            return 1
        fi
        make PREFIX="$prefix" install
        if [ $? -ne 0 ]; then
            echo "Error: OpenBLAS install failed"
            return 1
        fi
    else
        echo "Using existing OpenBLAS: $openblas_lib"
    fi

    if [ ! -f "$gsl_lib" ] || [ ! -f "$gsl_cblas_lib" ]; then
        echo "Building GSL for offline LAMMPS dependencies..."
        if [ ! -f "$deps_dir/gsl-2.7.1.tar.gz" ]; then
            echo "Error: $deps_dir/gsl-2.7.1.tar.gz not found"
            return 1
        fi
        rm -rf "$build_dir/gsl-2.7.1"
        tar -xzf "$deps_dir/gsl-2.7.1.tar.gz" -C "$build_dir"
        cd "$build_dir/gsl-2.7.1" || return 1
        ./configure --prefix="$prefix"
        if [ $? -ne 0 ]; then
            echo "Error: GSL configure failed"
            return 1
        fi
        make -j$JOB_COUNT
        if [ $? -ne 0 ]; then
            echo "Error: GSL build failed"
            return 1
        fi
        make install
        if [ $? -ne 0 ]; then
            echo "Error: GSL install failed"
            return 1
        fi
    else
        echo "Using existing GSL: $gsl_lib"
    fi

    if [ ! -f "$voro_lib" ] || [ ! -f "$voro_header" ]; then
        echo "Building Voro++ for offline LAMMPS dependencies..."
        if [ ! -f "$deps_dir/voro++-0.4.6.tar.gz" ]; then
            echo "Error: $deps_dir/voro++-0.4.6.tar.gz not found"
            return 1
        fi
        rm -rf "$build_dir/voro++-0.4.6"
        tar -xzf "$deps_dir/voro++-0.4.6.tar.gz" -C "$build_dir"
        make -C "$build_dir/voro++-0.4.6/src" \
            -j$JOB_COUNT CXX=g++ CFLAGS="-Wall -ansi -pedantic -O2 -fPIC"
        if [ $? -ne 0 ]; then
            echo "Error: Voro++ build failed"
            return 1
        fi
        make -C "$build_dir/voro++-0.4.6" PREFIX="$prefix" install
        if [ $? -ne 0 ]; then
            echo "Error: Voro++ install failed"
            return 1
        fi
    else
        echo "Using existing Voro++: $voro_lib"
    fi

    LAMMPS_DEPS_PREFIX=$prefix
    export LAMMPS_DEPS_PREFIX
    export LD_LIBRARY_PATH="$LAMMPS_DEPS_PREFIX/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
    return 0
}

# 执行环境检查（跳过解压模式）
if [ "$UNPACK_ONLY" = false ]; then
    perform_environment_check
fi

echo ""
echo "Starting file extraction..."

SKIP=`awk '/^__ARCHIVE_BELOW__/ { print NR + 1; exit 0; }' $0`
tail -n+$SKIP $0 | base64 -d > MatPL-2026.3.tar.gz.base64
BASE_DIR=$(pwd)
TEMP_DIR=$(mktemp -d)
FINAL_DIR=$BASE_DIR/MatPL-2026.3
ENV_DIR=$FINAL_DIR/matpl-2026.3
MATPL=$FINAL_DIR/MatPL-2026.3               #./MatPL-2026.3/MatPL-2026.3
LAMMPS_STABLE=$FINAL_DIR/lammps-25-4        #./MatPL-2026.3/lammps-25-4
LAMMPS_FORTRAN=$FINAL_DIR/lammps-fortran    #./MatPL-2026.3/lammps-fortran
LAMMPS_NEPKK=$FINAL_DIR/lammps-2026.3    #./MatPL-2026.3/lammps-2026.3 
LAMMPS_OFFLINE_DEPS=$FINAL_DIR/lammps-offline-deps

# Create final directory
mkdir -p $FINAL_DIR
mkdir -p $ENV_DIR

# Enter temporary directory and extract (suppress output)
cd $TEMP_DIR
echo "Extracting archive (output suppressed)..."
tar -xzf $BASE_DIR/MatPL-2026.3.tar.gz.base64 > /dev/null 2>&1

# Extract matpl environment package (suppress output)
echo "Extracting matpl environment..."
tar -xzf matpl-2026.3.tar.gz -C $ENV_DIR > /dev/null 2>&1

# Move MatPL and lammps_2024.5 directories to FINAL_DIR
mv $TEMP_DIR/MatPL-2026.3 $FINAL_DIR
mv $TEMP_DIR/lammps-offline-deps $LAMMPS_OFFLINE_DEPS

if [ "$COMPILE_FORTRAN" = true ]; then
    cp -r $TEMP_DIR/lammps-25-4 $LAMMPS_FORTRAN
fi

cp -r $TEMP_DIR/lammps-25-4 $LAMMPS_NEPKK

# Clean up temporary directory
rm -rf $TEMP_DIR

echo "Copy LAMMPS code done."

# Copy forcefield

cd $MATPL/src/lmps/lammps-2026.3/lmp_nepkokkos_cmake
bash kknep-patch.sh $LAMMPS_NEPKK

if [ "$COMPILE_FORTRAN" = true ]; then
    cp -r $MATPL/src/lmps/lammps-fortran/MATPL  $LAMMPS_FORTRAN/src/
    cp -r $MATPL/src/lmps/lammps-fortran/Makefile.mpi  $LAMMPS_FORTRAN/src/MAKE
fi

echo "Copy MATPL code to LAMMPS done."

echo "The file has been decompressed."

# If unpack-only mode is enabled, exit here
if [ "$UNPACK_ONLY" = true ]; then
  echo "Unpack-only mode completed."
  exit 0
fi

# Activate matpl-2026.3 Python environment
source $ENV_DIR/bin/activate
echo "ENV_DIR/bin/activate path is: $ENV_DIR/bin/activate"

# Compile MatPL
cd $MATPL/src
echo "Compiling MatPL..."
if [ $JOB_COUNT -gt 1 ]; then
    if [ "$COMPILE_FORTRAN" = true ]; then
        MATPL_BUILD_ARGS=(-j$JOB_COUNT -m nn)
    else
        MATPL_BUILD_ARGS=(-j$JOB_COUNT)
    fi
else
    if [ "$COMPILE_FORTRAN" = true ]; then
        MATPL_BUILD_ARGS=(-m nn)
    else
        MATPL_BUILD_ARGS=()
    fi
fi
if ! bash build.sh "${MATPL_BUILD_ARGS[@]}"; then
    echo "Error: MatPL compilation failed."
    exit 1
fi

# Set environment variables
export PATH=$MATPL/src/bin:$PATH
export PYTHONPATH=$MATPL/src/:$PYTHONPATH

echo "The compilation of the MatPL-2026.3 machine learning force field training platform has been completed."

# Compile lammps-2026.3 (only if OpenMPI is compatible)
LAMMPS_NEPKK_COMPILED=false
if [ "$OPENMPI_COMPATIBLE" = true ]; then
    build_lammps_offline_deps "$LAMMPS_OFFLINE_DEPS"
    if [ $? -ne 0 ]; then
        echo "Error: Failed to build offline dependencies for lammps-2026.3."
        exit 1
    fi

    # Locate the bundled Torch and MKL files required by the MATPLDP package.
    TORCH_DIR=$(python -c 'from pathlib import Path; import torch; print(Path(torch.__file__).resolve().parent / "share" / "cmake" / "Torch")')
    TORCH_LIB_DIR=$(python -c 'from pathlib import Path; import torch; print(Path(torch.__file__).resolve().parent / "lib")')
    if [ ! -f "$TORCH_DIR/TorchConfig.cmake" ]; then
        echo "Error: TorchConfig.cmake not found in the bundled Python environment: $TORCH_DIR"
        exit 1
    fi

    MKL_INCLUDE_DIR=$ENV_DIR/include
    if [ ! -f "$MKL_INCLUDE_DIR/mkl_vsl.h" ]; then
        echo "Error: MKL headers not found in the bundled Python environment. Ensure mkl-include is packed."
        exit 1
    fi
    if [ -f "$ENV_DIR/lib/libmkl_rt.so.2" ]; then
        MKL_LIBRARY=$ENV_DIR/lib/libmkl_rt.so.2
    elif [ -f "$ENV_DIR/lib/libmkl_rt.so" ]; then
        MKL_LIBRARY=$ENV_DIR/lib/libmkl_rt.so
    else
        echo "Error: MKL runtime library not found in the bundled Python environment: $ENV_DIR/lib"
        exit 1
    fi
    export LD_LIBRARY_PATH="$TORCH_LIB_DIR:$ENV_DIR/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

    LAMMPS_OPENBLAS_LIB=$LAMMPS_DEPS_PREFIX/lib/libopenblas.so
    cd $LAMMPS_NEPKK
    LAMMPS_BUILD_DIR=build
    DPREC_CMAKE_OPTION=
    if [ "$DPREC_ENABLED" = true ]; then
        LAMMPS_BUILD_DIR=build-64
        DPREC_CMAKE_OPTION="-DPREC_NEPINFER=ON"
    fi
    mkdir "$LAMMPS_BUILD_DIR"
    cd "$LAMMPS_BUILD_DIR"

    if ! cmake -C $MATPL/src/lmps/lammps-2026.3/lmp_nepkokkos_cmake/matplcomm.cmake \
       -DPKG_MESONT=no \
       -DPKG_JPEG=no \
       -DPKG_KOKKOS=yes \
       -DPKG_NEP_KK=yes \
       -DPKG_MATPLDP=yes \
       -DTorch_DIR="$TORCH_DIR" \
       -DCMAKE_CXX_STANDARD=17 \
       -DCMAKE_CUDA_ARCHITECTURES="$CMAKE_CUDA_ARCHITECTURES" \
       -DKokkos_ENABLE_CUDA=yes \
       -DKokkos_ENABLE_OPENMP=yes \
       -DKokkos_ENABLE_CUDA_LAMBDA=yes \
       -DFFT_KOKKOS=CUFFT \
       "-DKokkos_ARCH_${GPU_ARCH}=ON" \
       -DMKL_INCLUDE_DIR="$MKL_INCLUDE_DIR" \
       -DMKL_LIBRARY="$MKL_LIBRARY" \
       -DBLAS_LIBRARIES=$LAMMPS_OPENBLAS_LIB \
       -DLAPACK_LIBRARIES=$LAMMPS_OPENBLAS_LIB \
       -DGSL_ROOT_DIR=$LAMMPS_DEPS_PREFIX \
       -DPLUMED_URL=file://$LAMMPS_OFFLINE_DEPS/plumed-src-2.9.4.tgz \
       -DDOWNLOAD_VORO=OFF \
       -DVORO_LIBRARY=$LAMMPS_DEPS_PREFIX/lib/libvoro++.a \
       -DVORO_INCLUDE_DIR=$LAMMPS_DEPS_PREFIX/include/voro++ \
       $DPREC_CMAKE_OPTION \
       -DTEST_TIME=ON \
       ../cmake; then
        echo "Error: CMake configuration for lammps-2026.3 failed."
        exit 1
    fi

    if ! cmake --build . -j$JOB_COUNT; then
        echo "Error: lammps-2026.3 compilation failed."
        exit 1
    fi

cat <<EOF > "$LAMMPS_NEPKK/env.sh"
# Environment for MatPL-2026.3 lammps path
export PATH=$LAMMPS_NEPKK/$LAMMPS_BUILD_DIR:\$PATH
export LD_LIBRARY_PATH=$LAMMPS_DEPS_PREFIX/lib:$ENV_DIR/lib:$TORCH_LIB_DIR:\${LD_LIBRARY_PATH:-}
EOF

    echo "The compilation of the lammps-2026.3 has been completed."
    LAMMPS_NEPKK_COMPILED=true
else
    echo "⚠ OpenMPI not found or version < 4.0, skipping lammps-2026.3 compilation."
    # 创建一个空的 env.sh 避免后续 cat 出错（可选）
    echo "# LAMMPS-2026.3 was not compiled due to missing OpenMPI" > "$LAMMPS_NEPKK/env.sh"
fi

# 生成 matpl-env.sh（包含 MatPL 和 lammps-2026.3 的环境）
echo "source $ENV_DIR/bin/activate" > $FINAL_DIR/matpl-env.sh
cat $MATPL/env.sh >> $FINAL_DIR/matpl-env.sh
if [ "$LAMMPS_NEPKK_COMPILED" = true ]; then
    cat $LAMMPS_NEPKK/env.sh >> $FINAL_DIR/matpl-env.sh
else
    echo "# LAMMPS-2026.3 was not compiled due to missing OpenMPI" >> $FINAL_DIR/matpl-env.sh
fi

# Clean up temporary files
rm -rf $BASE_DIR/MatPL-2026.3.tar.gz.base64

# Check if files are generated successfully
echo ""
if [ -f "$FINAL_DIR/matpl-env.sh" ]; then
    echo "✓ Created matpl-env.sh"
    
    if [ "$LAMMPS_NEPKK_COMPILED" = true ]; then
        echo "✓ LAMMPS-2026.3 compiled successfully."
    else
        echo "⚠ LAMMPS-2026.3 compilation skipped (OpenMPI missing or < 4.0)."
    fi

    echo ""
    echo "Installation completed:"
    if [ "$LAMMPS_NEPKK_COMPILED" = true ]; then
        echo "  ✓ LAMMPS with lammps-2026.3 support installed"
    else
        echo "  ⚠ LAMMPS with lammps-2026.3 support was not compiled due to missing OpenMPI"
    fi
    if [ "$COMPILE_FORTRAN" = true ]; then
        echo "  ✓ MatPL Linear/NN support compiled with -m nn"
        echo "  - lammps-fortran interface compilation was skipped"
    fi
else
    echo "✗ Installation encountered errors. Please check the installation logs!"
fi

exit 0
